<?xml version='1.0'?>
<sdf version='1.6'>
  <world name='room'>
    <include><uri>model://ground_plane</uri></include>
    <!-- Overhead light, straight down (0 0 -1). The stock model://sun has a
         sideways direction (-0.5 0.1 -0.9), which lit left-facing and
         right-facing surfaces differently even though the geometry is
         mirror-symmetric - a visual cue that breaks the left/right
         ambiguity the exercise depends on. Straight down keeps the lighting
         symmetric about the centreline. -->
    <light name='overhead' type='directional'>
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <physics type='ode'>
      <real_time_update_rate>1000</real_time_update_rate>
      <max_step_size>0.001</max_step_size>
    </physics>

    <scene>
      <ambient>0.5 0.5 0.5 1</ambient>
      <shadows>false</shadows>
    </scene>
    <gui fullscreen='0'>
      <camera name='top_down'>
        <pose>0 1.9500 4.5 0 1.5707 1.5707</pose>
        <projection_type>orthographic</projection_type>
      </camera>
    </gui>
    <plugin name='gazebo_ros_state' filename='libgazebo_ros_state.so'>
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>50</update_rate>
    </plugin>

  <model name='wall_south'>
    <static>true</static>
    <pose>0.0000 -0.0250 0.1500 0 0 0</pose>
    <link name='link'>
      <collision name='c'>
        <geometry><box><size>3.1 0.05 0.3</size></box></geometry>
      </collision>
      <visual name='v'>
        <geometry><box><size>3.1 0.05 0.3</size></box></geometry>
        <material>
          <ambient>0.85 0.85 0.82 1</ambient>
          <diffuse>0.85 0.85 0.82 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
  <model name='wall_north'>
    <static>true</static>
    <pose>0.0000 3.9250 0.1500 0 0 0</pose>
